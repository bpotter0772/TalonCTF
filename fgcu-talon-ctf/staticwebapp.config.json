{
  "routes": [
    {
      "route": "/",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/index.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/dashboard",
      "serve": "/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/view-dashboard",
      "serve": "/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/view-challenge",
      "serve": "/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/view-scoreboard",
      "serve": "/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/fgcu-talon-ctf/*",
      "serve": "/index.html",
      "allowedRoles": ["authenticated"]
    }
  ],
  "auth": {
    "identityProviders": {
      "github": {
        "registration": {
          "clientIdSettingName": "GITHUB_CLIENT_ID",
          "clientSecretSettingName": "GITHUB_CLIENT_SECRET"
        }
      }
    }
  }
}
